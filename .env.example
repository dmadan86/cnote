# Copy to .env (gitignored) and fill in. Never commit real values.
# App role (non-superuser, subject to RLS). Password comes from DB_APP_PASSWORD via scripts/setup-db.sh.
DATABASE_URL=
# Owner role, used only for migrations
DATABASE_ADMIN_URL=
DB_APP_PASSWORD=
# Random 32+ byte string: openssl rand -base64 32
SESSION_SECRET=
# Optional AI providers (BYO-LLM). Without keys the deterministic local provider is used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 'sandbox' uses the built-in mock GSP.
GSP_MODE=sandbox
COLLAB_URL=ws://localhost:1234
COLLAB_PORT=1234
# Optional mention emails (plain text over SMTP). Leave SMTP_URL empty to disable; in-app notifications still work.
# SMTP_URL: your mail provider's smtps:// URL including its login; set it in .env only, never commit it.
SMTP_URL=
EMAIL_FROM=
# Origin used for links in emails (falls back to PUBLIC_BASE_URL, WEB_URL, then http://localhost:3000).
PUBLIC_WEB_URL=
