    {
      "name": "Visits",
      "fields": [
        {
          "name": "Ticket",
          "type": "autonumber",
          "config": {
            "prefix": "TKT-"
          }
        },
        {
          "name": "Machine",
          "type": "link",
          "config": {
            "table": "Machines",
            "multiple": false
          }
        },
        {
          "name": "Issue",
          "type": "text"
        },
        {
          "name": "Status",
          "type": "single_select",
          "config": {
            "options": [
              {
                "id": "o1",
                "name": "Open",
                "color": "gray"
              },
              {
                "id": "o2",
                "name": "Assigned",
                "color": "blue"
              },
              {
                "id": "o3",
                "name": "In progress",
                "color": "green"
              },
              {
                "id": "o4",
                "name": "Parts needed",
                "color": "amber"
              },
              {
                "id": "o5",
                "name": "Closed",
                "color": "red"
              }
            ]
          }
        },
        {
          "name": "Priority",
          "type": "single_select",
          "config": {
            "options": [
              {
                "id": "o1",
                "name": "Low",
                "color": "gray"
              },
              {
                "id": "o2",
                "name": "Medium",
                "color": "blue"
              },
              {
                "id": "o3",
                "name": "High",
                "color": "green"
              }
            ]
          }
        },
        {
          "name": "Technician",
          "type": "text"
        },
        {
          "name": "Visit date",
          "type": "date"
        },
        {
          "name": "Charge",
          "type": "currency",
          "config": {
            "decimals": 2
          }
        },
        {
          "name": "Details",
          "type": "long_text"
        }
      ],
      "views": [
        {
          "name": "All visits",
          "type": "grid",
          "config": {
            "v": 1
          }
        },
        {
          "name": "By status",
          "type": "kanban",
          "config": {
            "v": 1,
            "kanban": {
              "stack": "Status",
              "card_fields": ["Machine", "Issue"]
            }
          }
        }
      ],
