{
  "key": "stock_list",
  "name": "Stock list",
  "description": "Know what is in stock and what to reorder.",
  "tables": [
    {
      "name": "Items",
      "fields": [
        {
          "name": "Item",
          "type": "text"
        },
        {
          "name": "Category",
          "type": "single_select",
          "config": {
            "options": [
              {
                "id": "o1",
                "name": "Grocery",
                "color": "gray"
              },
              {
                "id": "o2",
                "name": "Stationery",
                "color": "blue"
              },
              {
                "id": "o3",
                "name": "Electrical",
                "color": "green"
              },
              {
                "id": "o4",
                "name": "Plumbing",
                "color": "amber"
              }
            ]
          }
        },
        {
          "name": "Quantity",
          "type": "number",
          "config": {
            "decimals": 0
          }
        },
        {
          "name": "Reorder level",
          "type": "number",
          "config": {
            "decimals": 0
          }
        },
        {
          "name": "Unit price",
          "type": "currency",
          "config": {
            "decimals": 2
          }
        },
        {
          "name": "Supplier phone",
          "type": "phone"
        },
        {
          "name": "Last restocked",
          "type": "date"
        }
      ],
      "views": [
        {
          "name": "All items",
          "type": "grid",
          "config": {
            "v": 1,
            "sorts": [
              {
                "field": "Quantity",
                "desc": false
              }
            ]
          }
        },
        {
          "name": "Low stock",
          "type": "grid",
          "config": {
            "v": 1,
            "sorts": [
              {
                "field": "Quantity",
                "desc": false
              }
            ],
            "filters": {
              "match": "and",
              "rules": [
                {
                  "field": "Quantity",
                  "op": "<=",
                  "value": 10
                }
              ]
            }
          }
        }
      ],
