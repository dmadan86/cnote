{
  "key": "event_rsvps",
  "name": "Event RSVPs",
  "description": "Guest list with replies, party size and meal choice.",
  "tables": [
    {
      "name": "Guests",
      "fields": [
        {
          "name": "Guest",
          "type": "text"
        },
        {
          "name": "Phone",
          "type": "phone"
        },
        {
          "name": "Email",
          "type": "email"
        },
        {
          "name": "Reply",
          "type": "single_select",
          "config": {
            "options": [
              {
                "id": "o1",
                "name": "Invited",
                "color": "gray"
              },
              {
                "id": "o2",
                "name": "Coming",
                "color": "blue"
              },
              {
                "id": "o3",
                "name": "Maybe",
                "color": "green"
              },
              {
                "id": "o4",
                "name": "Not coming",
                "color": "amber"
              }
            ]
          }
        },
        {
          "name": "Party size",
          "type": "number",
          "config": {
            "decimals": 0
          }
        },
        {
          "name": "Meal",
          "type": "single_select",
          "config": {
            "options": [
              {
                "id": "o1",
                "name": "Veg",
                "color": "gray"
              },
              {
                "id": "o2",
                "name": "Non-veg",
                "color": "blue"
              },
              {
                "id": "o3",
                "name": "Jain",
                "color": "green"
              }
            ]
          }
        },
        {
          "name": "Side",
          "type": "single_select",
          "config": {
            "options": [
              {
                "id": "o1",
                "name": "Bride",
                "color": "gray"
              },
              {
                "id": "o2",
                "name": "Groom",
                "color": "blue"
              },
              {
                "id": "o3",
                "name": "Family friend",
                "color": "green"
              }
            ]
          }
        },
        {
          "name": "Note",
          "type": "long_text"
        }
      ],
      "views": [
        {
          "name": "All guests",
          "type": "grid",
          "config": {
            "v": 1
          }
        },
        {
          "name": "By reply",
          "type": "kanban",
          "config": {
            "v": 1,
            "kanban": {
              "stack": "Reply",
              "card_fields": ["Phone", "Email"]
            }
          }
        }
      ],
