{
  "key": "order_tracker",
  "name": "Order tracker",
  "description": "Track customer orders from new to delivered, with amounts and payment status.",
  "tables": [
    {
      "name": "Orders",
      "fields": [
        {
          "name": "Order no",
          "type": "autonumber",
          "config": {
            "prefix": "ORD-"
          }
        },
        {
          "name": "Customer",
          "type": "link",
          "config": {
            "table": "Customers",
            "multiple": false
          }
        },
        {
          "name": "Item",
          "type": "text"
        },
        {
          "name": "Amount",
          "type": "currency",
          "config": {
            "decimals": 2
          }
        },
        {
          "name": "Status",
          "type": "single_select",
          "config": {
            "options": [
              {
                "id": "o1",
                "name": "New",
                "color": "gray"
              },
              {
                "id": "o2",
                "name": "Confirmed",
                "color": "blue"
              },
              {
                "id": "o3",
                "name": "Packed",
                "color": "green"
              },
              {
                "id": "o4",
                "name": "Dispatched",
                "color": "amber"
              },
              {
                "id": "o5",
                "name": "Delivered",
                "color": "red"
              },
              {
                "id": "o6",
                "name": "Cancelled",
                "color": "purple"
              }
            ]
          }
        },
        {
          "name": "Order date",
          "type": "date"
        },
        {
          "name": "Due date",
          "type": "date"
        },
        {
          "name": "Paid",
          "type": "checkbox"
        },
        {
          "name": "Notes",
          "type": "long_text"
        }
      ],
      "views": [
        {
          "name": "All orders",
          "type": "grid",
          "config": {
            "v": 1,
            "sorts": [
              {
                "field": "Order date",
                "desc": true
              }
            ]
          }
        },
        {
          "name": "By status",
          "type": "kanban",
          "config": {
            "v": 1,
            "kanban": {
              "stack": "Status",
              "card_fields": ["Customer", "Item", "Amount"]
            }
          }
        }
      ],
