{
  "key": "client_followups",
  "name": "Client follow-ups",
  "description": "Keep clients, their next call and every follow-up in one place.",
  "tables": [
    {
      "name": "Clients",
      "fields": [
        {
          "name": "Name",
          "type": "text"
        },
        {
          "name": "Company",
          "type": "text"
        },
        {
          "name": "Phone",
          "type": "phone"
        },
        {
          "name": "Email",
          "type": "email"
        },
