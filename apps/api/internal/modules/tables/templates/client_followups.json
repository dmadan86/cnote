          "name": "City",
          "type": "text"
        },
        {
          "name": "Next call",
          "type": "date"
        },
        {
          "name": "Stage",
          "type": "single_select",
          "config": {
            "options": [
              {
                "id": "o1",
                "name": "Lead",
                "color": "gray"
              },
              {
                "id": "o2",
                "name": "Talking",
                "color": "blue"
              },
              {
                "id": "o3",
                "name": "Quote sent",
                "color": "green"
              },
              {
                "id": "o4",
                "name": "Won",
                "color": "amber"
              },
              {
                "id": "o5",
                "name": "Lost",
                "color": "red"
              }
            ]
          }
        },
        {
          "name": "Deal value",
          "type": "currency",
          "config": {
            "decimals": 0
          }
        }
      ],
      "views": [
        {
          "name": "All clients",
          "type": "grid",
          "config": {
            "v": 1,
            "group": "Next call",
            "sorts": [
              {
                "field": "Next call",
                "desc": false
              }
            ]
          }
