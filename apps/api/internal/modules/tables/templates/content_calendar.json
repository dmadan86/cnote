{
  "key": "content_calendar",
  "name": "Content calendar",
  "description": "Plan posts across channels, from idea to published.",
  "tables": [
    {
      "name": "Posts",
      "fields": [
        {
          "name": "Title",
          "type": "text"
        },
        {
          "name": "Stage",
          "type": "single_select",
          "config": {
            "options": [
              {
                "id": "o1",
                "name": "Idea",
                "color": "gray"
              },
              {
                "id": "o2",
                "name": "Writing",
                "color": "blue"
              },
              {
                "id": "o3",
                "name": "Review",
                "color": "green"
              },
              {
                "id": "o4",
                "name": "Scheduled",
                "color": "amber"
              },
              {
                "id": "o5",
                "name": "Published",
                "color": "red"
              }
            ]
          }
        },
        {
          "name": "Channel",
          "type": "multi_select",
          "config": {
            "options": [
              {
                "id": "o1",
                "name": "Instagram",
                "color": "gray"
              },
              {
                "id": "o2",
                "name": "Facebook",
                "color": "blue"
              },
              {
                "id": "o3",
                "name": "YouTube",
                "color": "green"
              },
              {
                "id": "o4",
                "name": "Blog",
                "color": "amber"
              },
              {
                "id": "o5",
                "name": "WhatsApp",
                "color": "red"
              }
            ]
          }
        },
        {
          "name": "Publish date",
          "type": "date"
        },
        {
          "name": "Owner",
          "type": "text"
        },
        {
          "name": "Link",
          "type": "url"
        },
        {
          "name": "Brief",
          "type": "long_text"
        }
      ],
      "views": [
        {
          "name": "All posts",
          "type": "grid",
          "config": {
            "v": 1,
            "sorts": [
              {
                "field": "Publish date",
                "desc": false
              }
            ]
          }
        },
        {
          "name": "By stage",
          "type": "kanban",
          "config": {
            "v": 1,
            "kanban": {
              "stack": "Stage",
              "card_fields": ["Channel", "Publish date"]
            }
          }
        }
      ],
      "records": [
        {
          "Title": "Diwali sale announcement",
