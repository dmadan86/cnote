    "root": {
      "props": {
        "title": "{{name}}",
        "theme": {
          "primary": "#b93c0a",
          "background": "#fffbf5",
          "text": "#1c1917",
          "font": "rounded",
          "radius": "lg"
        }
      }
    },
    "content": [
