{
  "key": "shop",
  "name": "Bazaar",
  "description": "A website for your shop business.",
  "vertical": "Shop",
  "data": {
    "root": {
      "props": {
        "title": "{{name}}",
        "theme": {
          "primary": "#c2410c",
          "background": "#fffbf5",
          "text": "#1c1917",
          "font": "sans",
          "radius": "lg"
        }
      }
    },
    "content": [
      {
        "type": "Header",
        "props": {
          "id": "Header-00000001",
          "brand": "{{name}}",
          "links": []
        }
      },
      {
        "type": "Hero",
        "props": {
          "id": "Hero-00000002",
          "title": "{{name}}",
          "align": "center"
        }
      },
      {
        "type": "Gallery",
        "props": {
          "id": "Gallery-00000003",
          "title": "Gallery",
          "items": []
        }
      },
      {
        "type": "Services",
        "props": {
          "id": "Services-00000004",
          "title": "What we sell",
          "items": [
            {
              "name": "Your first service",
              "description": ""
            }
          ]
        }
      },
      {
        "type": "Pricing",
        "props": {
          "id": "Pricing-00000005",
          "title": "Pricing",
          "items": []
        }
      },
      {
        "type": "Testimonials",
        "props": {
          "id": "Testimonials-00000006",
          "title": "Testimonials",
          "items": []
        }
      },
      {
        "type": "MapHours",
        "props": {
          "id": "MapHours-00000007",
          "title": "Find us",
          "address": "{{address}}",
          "hours": []
        }
      },
      {
        "type": "ContactForm",
        "props": {
          "id": "ContactForm-00000008",
          "title": "Contact us",
          "phone": "{{phone}}",
          "email": "{{email}}",
          "address": "{{address}}",
          "submit_label": "Send"
        }
      },
      {
        "type": "Footer",
        "props": {
          "id": "Footer-00000009",
          "text": "{{name}}",
          "phone": "{{phone}}",
          "email": "{{email}}",
          "address": "{{address}}",
          "links": []
        }
      },
      {
        "type": "WhatsAppButton",
        "props": {
          "id": "WhatsAppButton-0000000a",
          "phone": "{{phone}}",
          "label": "WhatsApp"
        }
      }
    ]
  }
}
