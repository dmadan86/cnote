            },
            {
              "label": "Gallery",
              "href": "#Gallery-00000004"
            },
            {
              "label": "What customers say",
              "href": "#Testimonials-00000005"
            },
            {
              "label": "Visit the shop",
              "href": "#MapHours-00000006"
            }
          ],
          "cta_label": "Enquire",
          "cta_href": "#ContactForm-00000007",
          "variant": "left"
        }
      },
      {
        "type": "Hero",
        "props": {
          "id": "Hero-00000002",
          "title": "{{name}}",
          "cta_label": "Enquire now",
          "cta_href": "#ContactForm-00000007",
          "align": "left",
          "variant": "split"
        }
      },
      {
        "type": "Catalogue",
        "props": {
          "id": "Catalogue-00000003",
          "title": "Our products",
          "enquire": "both",
          "variant": "grid"
        }
      },
      {
        "type": "Gallery",
        "props": {
          "id": "Gallery-00000004",
          "title": "Gallery",
          "items": [],
          "variant": "strip"
        }
      },
      {
        "type": "Testimonials",
        "props": {
          "id": "Testimonials-00000005",
          "title": "What customers say",
          "items": [],
          "variant": "cards"
        }
      },
      {
        "type": "MapHours",
        "props": {
          "id": "MapHours-00000006",
          "title": "Visit the shop",
          "address": "{{address}}",
          "hours": [],
          "variant": "side"
        }
      },
      {
        "type": "ContactForm",
        "props": {
          "id": "ContactForm-00000007",
          "title": "Contact us",
          "phone": "{{phone}}",
          "email": "{{email}}",
          "address": "{{address}}",
          "submit_label": "Send",
          "variant": "side"
        }
      },
      {
        "type": "Footer",
        "props": {
          "id": "Footer-00000008",
          "text": "{{name}}",
          "phone": "{{phone}}",
          "email": "{{email}}",
          "address": "{{address}}",
          "links": [],
          "variant": "columns"
        }
      },
      {
        "type": "WhatsAppButton",
        "props": {
          "id": "WhatsAppButton-00000009",
          "phone": "{{phone}}",
          "label": "WhatsApp"
        }
