        }
      },
      {
        "type": "Gallery",
        "props": {
          "id": "Gallery-00000005",
          "title": "Gallery",
          "items": []
        }
      },
      {
        "type": "FAQ",
        "props": {
          "id": "FAQ-00000006",
          "title": "Frequently asked questions",
          "items": []
        }
      },
      {
        "type": "ContactForm",
        "props": {
