          "id": "Footer-00000009",
          "text": "{{name}}",
          "phone": "{{phone}}",
          "email": "{{email}}",
          "address": "{{address}}",
          "links": []
        }
      },
      {
        "type": "WhatsAppButton",
        "props": {
          "id": "WhatsAppButton-0000000a",
