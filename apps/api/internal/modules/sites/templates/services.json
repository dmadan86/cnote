{
  "key": "services",
  "name": "Trusty",
  "description": "A website for your services business.",
  "vertical": "Services",
  "data": {
    "root": {
      "props": {
        "title": "{{name}}",
        "theme": {
          "primary": "#1d4ed8",
          "background": "#ffffff",
          "text": "#0f172a",
          "font": "sans",
          "radius": "md"
        }
      }
    },
    "content": [
      {
        "type": "Header",
        "props": {
          "id": "Header-00000001",
          "brand": "{{name}}",
          "links": []
        }
      },
      {
        "type": "Hero",
        "props": {
          "id": "Hero-00000002",
          "title": "{{name}}",
          "align": "center"
        }
      },
      {
        "type": "Services",
        "props": {
          "id": "Services-00000003",
          "title": "Our services",
          "items": [
            {
              "name": "Your first service",
              "description": ""
            }
          ]
        }
      },
      {
        "type": "About",
        "props": {
          "id": "About-00000004",
          "title": "About us",
          "body": "Add your story here."
        }
      },
      {
        "type": "Testimonials",
        "props": {
          "id": "Testimonials-00000005",
          "title": "Testimonials",
          "items": []
        }
      },
      {
        "type": "FAQ",
        "props": {
          "id": "FAQ-00000006",
          "title": "Frequently asked questions",
          "items": []
        }
      },
      {
        "type": "CallToAction",
        "props": {
          "id": "CallToAction-00000007",
          "title": "Get in touch",
          "cta_label": "Contact us",
          "cta_href": "#ContactForm-00000008"
        }
      },
      {
        "type": "ContactForm",
        "props": {
          "id": "ContactForm-00000008",
          "title": "Contact us",
          "phone": "{{phone}}",
          "email": "{{email}}",
          "address": "{{address}}",
          "submit_label": "Send"
        }
      },
      {
        "type": "MapHours",
        "props": {
          "id": "MapHours-00000009",
          "title": "Find us",
          "address": "{{address}}",
          "hours": []
        }
      },
      {
        "type": "Footer",
        "props": {
          "id": "Footer-0000000a",
          "text": "{{name}}",
          "phone": "{{phone}}",
          "email": "{{email}}",
          "address": "{{address}}",
          "links": []
        }
      },
      {
        "type": "WhatsAppButton",
        "props": {
          "id": "WhatsAppButton-0000000b",
          "phone": "{{phone}}",
          "label": "WhatsApp"
        }
      }
    ]
  }
}
