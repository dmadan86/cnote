    {
      "id": "R6",
      "name": "Name mismatch + new workspace",
      "name_mismatch_points": 15,
      "new_workspace_bonus": 10,
      "new_workspace_threshold_days": 7,
      "description": "The site's name shares no word with the business name, and the workspace is under 7 days old. Both points apply only when the workspace is new."
    },
    {
      "id": "R7",
      "name": "Punycode or IP link host",
      "points": 30,
      "description": "A link host with a punycode (xn--) label or an IP address. Another 20 points when the workspace is under 7 days old.",
      "detection": "punycode: host label contains 'xn--'; IPv4: matches /^\\d{1,3}(\\.\\d{1,3}){3}$/; IPv6: host wrapped in [ ]",
      "new_workspace_points": 20
    },
    {
      "id": "R8",
      "name": "Visitor reports",
      "points_each": 10,
      "max_points": 20,
      "window_days": 30,
      "description": "Visitor reports from distinct addresses in the window. Capped at 20 points (design 18.13); reports are shown apart from verified evidence."
    },
    {
      "id": "R9",
      "name": "Web Risk match",
      "points": 100,
      "description": "A link matched Google Web Risk (malware, social engineering, unwanted software). The link is hidden at render time; the site goes to the top of the review queue. No automatic takedown."
    }
